# AWS Bedrock model configuration
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_TEMPERATURE=0.0

# Optional: override the default complaint criteria config file path
# COMPLAINT_CRITERIA_PATH=/path/to/complaint_criteria.json

# Disable OpenTelemetry SDK (avoids conflicts with Streamlit)
OTEL_SDK_DISABLED=true
